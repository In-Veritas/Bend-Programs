+def pcg_next_go(p: U32 & U32, +h: U32, +l: U32) -> RNG:
+  (+ph, +pl) = p
+  +hi = U32.add(U32.add(ph, U32.mul(h, 1284865837)), U32.mul(l, 1481765933))
+  +lo = U32.add(pl, 2495175643)
+  RNG{U32.add(U32.add(hi, 3661511115), F.b2u(U32.is_lt(lo, pl))), lo}
+
