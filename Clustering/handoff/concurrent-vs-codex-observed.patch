+def pcg_out(+h: U32, +l: U32) -> U32:
+  +xh = U32.xor(h, U32.shrn(h, 18n))
+  +xl = U32.xor(l, U32.or(U32.shrn(l, 18n), U32.shln(h, 14n)))
+  +xs = U32.or(U32.shrn(xl, 27n), U32.shln(xh, 5n))
+  +rot = U32.shrn(h, 27n)
+  U32.or(F.shr(xs, rot), F.shl(xs, U32.and(U32.sub(32, rot), 31)))
+
+
+
