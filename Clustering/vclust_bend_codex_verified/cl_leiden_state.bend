def new(+n: U32, rows: Array<List<&2, G.Nb>>) -> S:
  +d = G.depth(n)
  pair(Array<List<&2, G.Nb>>, Array<List<&2, G.Nb>>, S,
    Array.clone(List<&2, G.Nb>, rows), rows => original_rows =>
  S{rows, original_rows, Array.new(List<&2, U32>, d, Nil{}), G.u32_array(n, 0), G.u32_array(n, 0), G.u32_array(n, 0), G.u32_array(n, 0), G.u32_array(n, 0), G.u32_array(n, 0), G.u32_array(n, 0), G.u32_array(n, 0), G.u32_array(n, 0), G.u32_array(n, 0), G.u32_array(n, 0), G.u32_array(n, 0), G.u32_array(n, 0), Array.new(F.D, d, F.D{0, 0}), Array.new(F.D, d, F.D{0, 0}), Array.new(F.D, d, F.D{0, 0}), Array.new(F.D, d, F.D{0, 0}), Array.new(F.D, d, F.D{0, 0}), Array.new(F.D, d, F.D{0, 0}), 2235320806, 1955588763, False{}, False{}})

